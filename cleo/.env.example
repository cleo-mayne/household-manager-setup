# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...
CLEO_MODEL=claude-sonnet-4-6

DISCORD_TOKEN=
DISCORD_GUILD_ID=1477094930647355626

# Comma-separated Discord user IDs allowed to talk to Cleo with full tool access.
TRUSTED_DISCORD_IDS=

# Comma-separated channel IDs where Cleo uses nanny-mode persona.
NANNY_CHANNEL_IDS=

# Paths
OBSIDIAN_VAULT=/Users/greg/Obsidian
BRAIN_MCP_CMD=python
BRAIN_MCP_ARGS=-m,brain.mcp_server

# Webhooks for scheduled pipelines
DISCORD_DAILY_BRIEF_WEBHOOK=
DISCORD_ALERTS_WEBHOOK=
DISCORD_CLEO_LOG_WEBHOOK=

# iMessage via BlueBubbles (self-hosted on the Mac Studio)
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
IMESSAGE_LISTEN_HOST=127.0.0.1
IMESSAGE_LISTEN_PORT=8787
# Comma-separated iMessage handles (emails / phone numbers) with write access.
TRUSTED_IMESSAGE_HANDLES=

# Optional Todoist
TODOIST_API_TOKEN=
