<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  qmd vault reindex, hourly. Replace __CLEO_DIR__ and __PYTHON__.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cleo.qmd-reindex</string>

    <key>WorkingDirectory</key>
    <string>__CLEO_DIR__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>cleo.scheduled.qmd_reindex</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__CLEO_DIR__/src</string>
    </dict>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>__CLEO_DIR__/logs/qmd-reindex.out.log</string>

    <key>StandardErrorPath</key>
    <string>__CLEO_DIR__/logs/qmd-reindex.err.log</string>
</dict>
</plist>
